# Nexus AI backend — environment variables (Milestone M0.2B)
#
# Copy this file to `.env` in the `backend/` directory and fill in the
# values marked "required — no default". Everything else already has a
# sensible local-development default in app/config/settings.py and only
# needs to be overridden if your setup differs from the defaults assumed
# by docker-compose.yml at the repository root.
#
# This file is read by app/config/settings.py via pydantic-settings.
# Never commit a real `.env` — only this example is checked in.

# =============================================================================
# Application
# =============================================================================

APP_NAME=Nexus AI
# One of: local, development, staging, production
APP_ENV=local
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# required — no default. Generate a real random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=changeme-generate-a-real-secret-key

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# S1E — implementation defaults, not a frozen TDD value (see settings.py)
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# =============================================================================
# Database (PostgreSQL) — matches docker-compose.yml's postgres service
# =============================================================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexus_ai
# required — no default
POSTGRES_USER=nexus
# required — no default
POSTGRES_PASSWORD=changeme

# =============================================================================
# Redis — matches docker-compose.yml's redis service
# =============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379

# =============================================================================
# Qdrant — matches docker-compose.yml's qdrant service
# =============================================================================

QDRANT_HOST=localhost
QDRANT_PORT=6333

# =============================================================================
# MinIO — matches docker-compose.yml's minio service
# =============================================================================

MINIO_ENDPOINT=localhost:9000
# required — no default
MINIO_ROOT_USER=nexus_minio_admin
# required — no default
MINIO_ROOT_PASSWORD=changeme
MINIO_BUCKET=nexus-documents

# =============================================================================
# Mail — matches docker-compose.yml's mailpit service (no auth needed locally)
# =============================================================================

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@nexus-ai.local

# =============================================================================
# AI — Google Gemini
# =============================================================================

# required for Q&A — create one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# comma-separated, tried in order when the main model is overloaded, out of
# free-tier quota or times out (leave empty to disable)
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=45
# embeddings for semantic search (stored as vector(768) — see alembic 20261027)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# =============================================================================
# Local development conveniences
# =============================================================================

# true = new accounts are active immediately (no verification email needed).
# Never enable in production.
AUTO_VERIFY_EMAILS=false
